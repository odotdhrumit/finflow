<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_oryvo_logo"
            android:contentDescription="ORYVO Logo" />

        <TextView
            android:id="@+id/widget_large_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="ORYVO"
            android:textColor="#6F2DBD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEGA OVERVIEW"
            android:textColor="#A663CC"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Total Balance Section -->
    <LinearLayout
        android:id="@+id/widget_large_balance_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL BALANCE"
            android:textColor="#5D546D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_large_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="₹0"
            android:textColor="#6F2DBD"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3 Metrics: Savings, Investments, Loan/EMI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Savings -->
        <LinearLayout
            android:id="@+id/widget_large_savings_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Savings"
                android:textColor="#5D546D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_large_savings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="#A663CC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Investments -->
        <LinearLayout
            android:id="@+id/widget_large_investments_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Investments"
                android:textColor="#5D546D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_large_investments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="#6F2DBD"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Loan / EMI -->
        <LinearLayout
            android:id="@+id/widget_large_loans_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan / EMI"
                android:textColor="#5D546D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_large_loans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="#A663CC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle divider using ImageView -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#E4DFEE" />

    <!-- Latest Transaction Section -->
    <LinearLayout
        android:id="@+id/widget_large_tx_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LATEST TRANSACTION"
            android:textColor="#5D546D"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_large_tx_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No transactions yet"
                android:textColor="#1E1430"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_large_tx_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#5D546D"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle divider using ImageView -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#E4DFEE" />

    <!-- Bottom Split: Next EMI & Savings Goal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Next EMI Card -->
        <LinearLayout
            android:id="@+id/widget_large_emi_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_sub_card"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT EMI"
                android:textColor="#6F2DBD"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_large_emi_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No EMI scheduled"
                android:textColor="#1E1430"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_large_emi_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="-"
                android:textColor="#5D546D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_large_emi_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#A663CC"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Savings Goal Card -->
        <LinearLayout
            android:id="@+id/widget_large_goal_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_sub_card"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVINGS GOAL"
                android:textColor="#6F2DBD"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_large_goal_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No savings goal"
                android:textColor="#1E1430"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_large_goal_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₹0 / ₹0"
                android:textColor="#5D546D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_large_goal_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#A663CC"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
